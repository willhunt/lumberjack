# Generated by Cargo
# will have compiled files and executables
/target/

# Data written by example and test runs. A project's config.json describes the
# setup and stays tracked; the results a run produces do not.
results.csv
results.json
# One recording among several, from a session that started and stopped.
results-*.csv
results-*.json
*.hdf
results.db
results.db-wal
results.db-shm

# Files written by `lumberdaq export`. Derived from a results database, and
# rewritten from it whenever one is missing, so there is nothing here that
# recording did not already produce.
export/
