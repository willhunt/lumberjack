{
  "info": {
    "name": "Example measurement",
    "author": "Joesephine Bloggs"
  },
  "storage": "sqlite",
  "devices": [
    {
      "info": {
        "name": "Test device",
        "description": "-"
      },
      "hardware": {
        "type": "MockHardware",
        "description": "This is a mock device that uses no hardware. It is used for testing and development purposes.",
        "channels": [
          {
            "name": "Random 1",
            "unit": "-",
            "description": "Random number generator",
            "input": "Random"
          }
        ]
      },
      "read_interval_ms": 500
    },
    {
      "info": {
        "name": "Serial test device",
        "description": "Device streaming over serial."
      },
      "hardware": {
        "type": "SerialStream",
        "description": "Device streaming over serial.",
        "port": "COM3",
        "baudrate": 115200,
        "frame_pattern": "#([^#$]*)\\$",
        "channels": [
          {
            "name": "Pressure",
            "unit": "Pa",
            "description": "Differential pressure sensor",
            "index": 1
          },
          {
            "name": "Pump Activation",
            "unit": "-",
            "description": "Pump on (1) or off (0)",
            "index": 3
          }
        ]
      },
      "read_interval_ms": 100
    }
  ]
}