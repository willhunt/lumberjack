{
  "info": {
    "name": "Scaled channels",
    "author": "Will Hunt"
  },
  "devices": [
    {
      "info": {
        "name": "Rig"
      },
      "hardware": {
        "type": "MockHardware",
        "acquisition": {
          "mode": "streaming",
          "sample_interval_ms": 50
        },
        "channels": [
          {
            "name": "Flow",
            "unit": "L/min",
            "scale": {
              "from": "4-20 mA transmitter",
              "equation": "(((x / shunt_ohms) * 1000 - 4) / 16) * (high - low) + low",
              "parameters": {
                "shunt_ohms": 120,
                "low": 0,
                "high": 29
              }
            },
            "input": {
              "Constant": 1.44
            }
          },
          {
            "name": "Pressure",
            "unit": "bar",
            "scale": "x * 5 + 5",
            "input": {
              "Sine": {
                "frequency_hz": 0.5
              }
            }
          },
          {
            "name": "Raw sine",
            "unit": "V",
            "input": {
              "Sine": {
                "frequency_hz": 0.5
              }
            }
          }
        ]
      }
    }
  ]
}
