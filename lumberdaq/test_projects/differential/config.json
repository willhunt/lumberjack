{
  "info": {
    "name": "Differential",
    "author": "-"
  },
  "storage": "sqlite",
  "devices": [
    {
      "info": {
        "name": "Transducer",
        "description": "-"
      },
      "read_interval_ms": 50,
      "hardware": {
        "type": "MockHardware",
        "description": "-",
        "acquisition": {
          "mode": "streaming",
          "sample_interval_ms": 50
        },
        "channels": [
          {
            "name": "High",
            "unit": "bar",
            "description": "-",
            "input": {
              "Sine": {
                "frequency_hz": 0.5
              }
            }
          },
          {
            "name": "Low",
            "unit": "bar",
            "description": "-",
            "input": {
              "Sine": {
                "frequency_hz": 0.25
              }
            }
          }
        ]
      }
    },
    {
      "info": {
        "name": "Slow probe",
        "description": "-"
      },
      "read_interval_ms": 500,
      "hardware": {
        "type": "MockHardware",
        "description": "-",
        "acquisition": {
          "mode": "streaming",
          "sample_interval_ms": 500
        },
        "channels": [
          {
            "name": "Temp",
            "unit": "bar",
            "description": "-",
            "input": {
              "Sine": {
                "frequency_hz": 0.1
              }
            }
          }
        ]
      }
    }
  ],
  "calculated": {
    "info": {
      "name": "Derived",
      "description": "-"
    },
    "channels": [
      {
        "name": "Delta P",
        "unit": "bar",
        "description": "same device, exact pairing",
        "inputs": {
          "high": {
            "device": "Transducer",
            "channel": "High"
          },
          "low": {
            "device": "Transducer",
            "channel": "Low"
          }
        },
        "equation": "high - low"
      },
      {
        "name": "Flow",
        "unit": "L/min",
        "description": "sqrt of a differential",
        "inputs": {
          "high": {
            "device": "Transducer",
            "channel": "High"
          },
          "low": {
            "device": "Transducer",
            "channel": "Low"
          }
        },
        "equation": "sqrt(abs(high - low)) * 12"
      },
      {
        "name": "Corrected",
        "unit": "bar",
        "description": "mixed rates, across devices",
        "inputs": {
          "p": {
            "device": "Transducer",
            "channel": "High"
          },
          "t": {
            "device": "Slow probe",
            "channel": "Temp"
          }
        },
        "equation": "p * (1 + t * 0.01)"
      }
    ]
  }
}